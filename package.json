{
  "name": "srd-personaggi-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/layout.mjs",
    "e2e:smoke": "node --experimental-strip-types e2e/smoke.mjs",
    "e2e:offline": "node --experimental-strip-types e2e/offline.mjs",
    "validate:data": "tsx scripts/validate-data.ts",
    "extract:data": "tsx scripts/extract-foundations.ts && tsx scripts/extract-spells.ts && tsx scripts/extract-origins.ts && tsx scripts/extract-species.ts && tsx scripts/extract-classes.ts && tsx scripts/extract-rules.ts && tsx scripts/extract-magic.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
